#!/bin/sh
# Reject a commit whose staged C++ files are not clang-formatted, the same
# check the CI format job runs. It checks the staged contents, not the working
# tree, so a partially staged file is judged by what will be committed.
#
# CI uses clang-format-18; set CLANG_FORMAT to pick another binary.

clang_format=${CLANG_FORMAT:-clang-format}
if ! command -v "$clang_format" >/dev/null 2>&1; then
    echo "pre-commit: $clang_format not found (set CLANG_FORMAT)" >&2
    exit 1
fi

git diff --cached --name-only --diff-filter=ACMR -- \
    '*.cpp' '*.hpp' '*.h' '*.cc' '*.cxx' '*.hh' '*.hxx' |
{
    status=0
    while IFS= read -r file; do
        git show ":$file" |
            "$clang_format" --dry-run --Werror --assume-filename="$file" || status=1
    done
    if [ "$status" -ne 0 ]; then
        echo "pre-commit: run clang-format -i on the files above and stage them again" >&2
    fi
    exit "$status"
}
